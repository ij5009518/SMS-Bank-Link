# Copy to .env and fill in. Never commit the real .env.

# ── Core ───────────────────────────────────────────────────────────────────
# Port the API server listens on (required).
PORT=5000
# Postgres connection string (required).
DATABASE_URL=postgres://user:password@localhost:5432/textbanks

# ── Security (required in any non-local environment) ─────────────────────────
# HMAC key used to sign session/admin tokens. Use a long random string.
AUTH_SECRET=
# Admin dashboard password. Admin login is disabled until this is set.
ADMIN_PASSWORD=
# Encrypts Teller bank access tokens at rest. Falls back to AUTH_SECRET if unset.
TELLER_ENCRYPTION_KEY=

# ── Frontend build ───────────────────────────────────────────────────────────
BASE_PATH=/
# Public site URL used in emails and password-reset links.
WEBSITE_URL=https://textbanks.app

# ── CORS (optional) ──────────────────────────────────────────────────────────
# Comma-separated allowlist of origins. Leave unset to reflect the request origin.
CORS_ORIGIN=

# ── SignalWire (SMS) ─────────────────────────────────────────────────────────
SIGNALWIRE_PROJECT_ID=
SIGNALWIRE_TOKEN=
SIGNALWIRE_SPACE_URL=
SIGNALWIRE_PHONE_NUMBER=
# Public URL SignalWire posts the inbound webhook to (used to validate the
# request signature behind a proxy; otherwise reconstructed from headers).
PUBLIC_WEBHOOK_URL=

# ── Teller (bank data) ───────────────────────────────────────────────────────
TELLER_APPLICATION_ID=
TELLER_ENVIRONMENT=sandbox

# ── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=Text Banks <info@textbanks.com>
ADMIN_EMAIL=admin@textbanks.com

# ── Google Sign-In (optional) ────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
